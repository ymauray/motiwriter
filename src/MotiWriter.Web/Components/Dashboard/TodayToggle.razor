<div class="today">
    <button type="button"
            class="today-button @(Written ? "done" : null)"
            aria-pressed="@(Written ? "true" : "false")"
            @onclick="OnToggle">
        <span class="mark" aria-hidden="true">@(Written ? "✓" : "✎")</span>
        <span>@(Written ? "Écrit aujourd'hui" : "J'ai écrit aujourd'hui")</span>
    </button>
    <p class="hint">@(Written ? "Un clic de plus pour annuler." : "Quelques mots suffisent.")</p>
</div>

@code {
    [Parameter] public bool Written { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
