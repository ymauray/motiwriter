<div class="toast-region" role="status" aria-live="polite">
    @if (Change is { } change)
    {
        <div class="toast" @key="change"
             @onmouseenter="OnPause" @onmouseleave="OnResume"
             @onfocusin="OnPause" @onfocusout="OnResume">
            <span>@FrenchDates.Confirmation(change, Today)</span>
            <button type="button" class="undo" @onclick="OnUndo">Annuler</button>
            <button type="button" class="close" aria-label="Fermer" @onclick="OnDismiss">×</button>
        </div>
    }
</div>

@code {
    [Parameter] public WritingDayChange? Change { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public EventCallback OnUndo { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>Le pointeur ou le focus est sur le bandeau : on suspend sa disparition.</summary>
    [Parameter] public EventCallback OnPause { get; set; }

    [Parameter] public EventCallback OnResume { get; set; }
}
