@page "/historique"
@inject IWritingDayService WritingDays
@inject TimeProvider Clock

<PageTitle>Historique · MotiWriter</PageTitle>

<section class="intro">
    <p class="eyebrow">Historique</p>
    <h1>Le fil des jours</h1>
    <p class="lede">Chaque jour coché ou décoché, mois par mois, du plus récent au plus ancien.</p>
</section>

<section class="months">
    @if (_months.Count == 0)
    {
        <HistoryList Changes="[]" Today="_today" />
    }
    @foreach (var month in _months)
    {
        <details class="month" open="@month.Is(_today)">
            <summary>
                <span class="chevron" aria-hidden="true"></span>
                <span class="name">@FrenchDates.Month(month.Year, month.Month)</span>
                <span class="count">@FrenchDates.Changes(month.Changes.Count)</span>
            </summary>
            <div class="body">
                <HistoryList Changes="month.Changes" Today="_today" />
            </div>
        </details>
    }
</section>

@code {
    private IReadOnlyList<HistoryMonth> _months = [];
    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _months = await WritingDays.GetHistoryByMonthAsync();
    }
}
