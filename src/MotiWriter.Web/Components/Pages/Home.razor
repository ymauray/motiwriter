@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IDashboardService Dashboard
@inject IWritingDayService WritingDays

<PageTitle>MotiWriter</PageTitle>

@if (_summary is { } s)
{
    <section class="hero">
        <p class="eyebrow">Tableau de bord</p>
        <h1>MotiWriter</h1>
        <p class="lede">
            @if (s.Statistics.TotalDays == 0)
            {
                <span>Votre carnet est encore vierge. Quelques mots aujourd'hui, et l'aventure commence.</span>
            }
            else
            {
                <span>Vous avez écrit <em>@FrenchDates.Days(s.Statistics.TotalDays)</em>.</span>
                @if (s.Statistics.CurrentStreak > 1)
                {
                    <span> Votre série en cours dure depuis @FrenchDates.Days(s.Statistics.CurrentStreak) — continuez.</span>
                }
                else
                {
                    <span> Quelques mots aujourd'hui suffisent à relancer la série.</span>
                }
            }
        </p>
        <TodayToggle Written="s.WrittenToday" OnToggle="() => ToggleAsync(s.Today)" />
    </section>

    <WeekStrip Week="s.CurrentWeek" Today="s.Today" OnToggle="ToggleAsync" />

    <section class="stats" aria-label="Statistiques">
        <StatCard Value="@s.Statistics.TotalDays" Label="jours écrits" Caption="depuis le début" />
        <StatCard Value="@s.Statistics.CurrentStreak" Label="série en cours" Caption="jours consécutifs" />
        <StatCard Value="@s.Statistics.LongestStreak" Label="plus longue série" Caption="votre record" />
        <StatCard Value="@s.Statistics.DaysThisMonth" Label="@($"en {s.Today.ToString("MMMM")}")" Caption="@($"sur {FrenchDates.Days(s.Today.Day)}")" />
    </section>

    <section class="panel">
        <div class="section-head">
            <h2>Les vingt dernières semaines</h2>
            <div class="legend">
                <span class="swatch"></span> silence
                <span class="swatch written"></span> écrit
            </div>
        </div>
        <WritingCalendar Weeks="s.Weeks" Today="s.Today" OnToggle="ToggleAsync" />
        <p class="note">Cliquez sur un jour pour le cocher ou le décocher.</p>
    </section>

    <section class="panel">
        <div class="section-head">
            <h2>Dernières modifications</h2>
            <a href="historique">Tout l'historique</a>
        </div>
        <HistoryList Changes="_history" Today="s.Today" />
    </section>

    <UndoToast Change="_lastChange" Today="s.Today" OnUndo="UndoAsync" OnDismiss="HideToast"
               OnPause="CancelToastTimer" OnResume="StartToastTimer" />
}

@code {
    private static readonly TimeSpan ToastDuration = TimeSpan.FromSeconds(8);

    private DashboardSummary? _summary;
    private IReadOnlyList<WritingDayChange> _history = [];
    private WritingDayChange? _lastChange;
    private CancellationTokenSource? _toastTimer;
    private bool _busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _summary = await Dashboard.GetSummaryAsync(weeks: 20);
        _history = await WritingDays.GetHistoryAsync(limit: 5);
    }

    private async Task ToggleAsync(DateOnly day)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        try
        {
            var change = await WritingDays.ToggleAsync(day);
            await ReloadAsync();
            ShowToast(change);
        }
        catch (WritingDayInFutureException)
        {
            // Les jours futurs ne sont pas cliquables ; on ignore un éventuel clic tardif
            // (par exemple si la page est restée ouverte après minuit).
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UndoAsync()
    {
        if (_busy || _lastChange is not { } change)
        {
            return;
        }
        _busy = true;
        try
        {
            HideToast();
            await WritingDays.SetWrittenAsync(change.Day, !change.Written);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowToast(WritingDayChange change)
    {
        _lastChange = change;
        StartToastTimer();
    }

    private void StartToastTimer()
    {
        CancelToastTimer();
        if (_lastChange is null)
        {
            return;
        }
        _toastTimer = new CancellationTokenSource();
        _ = HideToastLaterAsync(_toastTimer.Token);
    }

    private async Task HideToastLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(ToastDuration, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() =>
        {
            _lastChange = null;
            StateHasChanged();
        });
    }

    private void HideToast()
    {
        CancelToastTimer();
        _lastChange = null;
    }

    private void CancelToastTimer()
    {
        _toastTimer?.Cancel();
        _toastTimer?.Dispose();
        _toastTimer = null;
    }

    public void Dispose() => CancelToastTimer();
}
