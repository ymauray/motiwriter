@inject NavigationManager Navigation

@code {
    // Filet de sécurité : en temps normal, le middleware d'autorisation redirige déjà vers /connexion.
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"connexion?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
