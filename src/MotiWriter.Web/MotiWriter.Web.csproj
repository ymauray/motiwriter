<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MotiWriter.Core\MotiWriter.Core.csproj" />
    <ProjectReference Include="..\MotiWriter.Infrastructure\MotiWriter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Apple" Version="10.1.0" />
    <PackageReference Include="AspNet.Security.OAuth.Discord" Version="10.1.0" />
    <PackageReference Include="AspNet.Security.OAuth.Twitch" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>d75a3993-6cf4-4e49-96c6-bcca2dd16c52</UserSecretsId>
  </PropertyGroup>

  <!--
    Publication en binaire autonome : `dotnet publish src/MotiWriter.Web -r <rid>`
    (osx-arm64, linux-x64, win-x64…). Le runtime .NET et ASP.NET Core sont embarqués dans un
    exécutable unique ; seuls wwwroot/ et les fichiers appsettings*.json restent à côté.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- La bibliothèque native SQLite (e_sqlite3) est elle aussi incluse dans l'exécutable. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Pas de découpage (trimming) : Blazor et l'authentification reposent sur la réflexion. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
